# Neo4j — necessário somente ao executar scripts com --apply.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-local-password
NEO4J_DATABASE=neo4j

# Identificadores/endpoint opcionais usados pela configuração do ambiente.
AURA_INSTANCEID=replace-with-your-aura-instance-id
AURA_INSTANCENAME=replace-with-your-aura-instance-name
TAILSCALE_MODEL_HOST=replace-with-your-model-host